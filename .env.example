# ============================================================================
# Environment template — copy to `.env` and fill in values.
# Real secrets must NEVER be committed; `.env*` files are gitignored.
#
# One machine = one agent (CLAUDE.md). Giving this machine to another agent, or
# moving this agent to another machine, is a change to this file only.
# Setup walkthrough: docs/mac-setup.md
# ============================================================================

# --- Who this agent is ----------------------------------------------------------
# Name used in the agent's own prompt (how it introduces itself).
AGENT_NAME=
# The agent's own Slack member id (profile → ⋮ → Copy member ID), e.g. U0123ABCD.
AGENT_SLACK_USER_ID=
# What the agent is on the team for (one line, Korean is fine). Goes into its own
# prompt and into channel triage below. Empty = no assigned work yet.
AGENT_ROLE=
# People (comma-separated member ids). A message from one of them resets the
# agent↔agent loop guard below. At least one is required — usually you.
HUMAN_SLACK_USER_IDS=

# --- Slack: receive and read only ----------------------------------------------
# App-level token for Socket Mode (scope: connections:write). Starts with xapp-.
SLACK_APP_TOKEN=
# Token for READ lookups (user / channel names). The agent's user token (xoxp-)
# when events are subscribed on behalf of the agent — see docs/mac-setup.md.
# The process refuses to boot if this token holds any write scope (chat:write …):
# messages are sent through the Slack client on screen, never through the API.
# Sole exception: users.profile:write while SLACK_STATUS=on (below).
SLACK_READ_TOKEN=
# Which client the agent works in: `desktop` (Slack app) | `web` (app.slack.com in a browser).
SLACK_CLIENT=desktop
# After this many agent messages in a channel with no human in between, the
# agent stops answering other agents there until a human speaks.
MAX_AGENT_EXCHANGES=4

# --- Channel triage ---------------------------------------------------------------
# Channel messages that do not mention the agent (and do not mention anyone else)
# get a quick look: one tool-less call to a small model decides whether the agent
# should answer anyway. Yes → the message joins the queue behind the messages
# addressed to the agent. No → only the reason is logged. `on` | `off`.
CHANNEL_TRIAGE=on
# The judge's model (alias or full name); empty = the CLI's default.
TRIAGE_MODEL=haiku
# Seconds a channel's messages gather before one look at them all (fewer calls).
TRIAGE_WAIT_SECONDS=30

# --- Slack status ------------------------------------------------------------------
# The agent keeps its Slack status current ("don't clear") through the API — the
# one exception to "sending is GUI only": SLACK_READ_TOKEN may then hold exactly one
# write scope, users.profile:write (User Token Scopes), and nothing else.
#   starting work                         → :large_green_circle: 근무 중
#   desk waiting for macOS permissions    → :warning: 화면 권한 필요 · 사람의 확인을 기다리는 중
#   graceful stop for `service:restart`   → :arrows_counterclockwise: 재시작 중 · 곧 돌아옵니다
#   graceful stop, nothing left           → :zzz: 꺼져 있음
#   graceful stop, messages/tasks waiting → :inbox_tray: 꺼져 있음 · 남은 일 N건은 다음에 켜지면 처리
# A forced exit, crash or power cut leaves the last status as it was. The list lives
# in src/agent/status.ts. `on` | `off` (off = the scope is refused again at boot).
SLACK_STATUS=on

# --- Engine (the brain) ----------------------------------------------------------
# Driver: `claude-cli` — runs `claude -p` with this machine's Claude login.
ENGINE_DRIVER=claude-cli
# Path or name of the Claude Code CLI.
CLAUDE_BIN=claude
# Model alias or full name; empty = the CLI's default.
CLAUDE_MODEL=
# Where the engine runs; empty = ~/.slack-agent-org/engine. Keep it outside this
# repository, or the engine reads the developers' CLAUDE.md on every call.
ENGINE_WORK_DIR=
# Upper bound on tool round trips in one turn (a runaway brake, not an interrupt).
ENGINE_MAX_TURNS=80

# --- Desk (the hands) -------------------------------------------------------------
# Compiled helper that moves the mouse and types (bun run desk:build).
DESK_HELPER_PATH=.bin/desk-helper
# Longest edge, in pixels, of the screenshots the model sees.
DESK_MAX_EDGE=1440
# Localhost port of the desk tool server; 0 = any free port.
TOOLS_PORT=0

# --- Display ---------------------------------------------------------------------
# Time zone for the times the agent sees (Slack shows local times too).
TIME_ZONE=Asia/Seoul

# --- Local state -----------------------------------------------------------------
# Conversation memory, queue, logs and screenshots.
DATA_DIR=data
